# 统一换行符，避免跨平台协作时的 CRLF/LF 噪声
* text=auto eol=lf

# 明确声明二进制类型，防止 Git 尝试转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.apk binary
*.jar binary
*.jks binary
*.keystore binary

# Windows 下需要保留 CRLF 的脚本
*.bat text eol=crlf
*.cmd text eol=crlf

# 语言统计：把生成的数据排除在“语言占比”之外
public/data/law-code.json linguist-generated=true
package-lock.json linguist-generated=true
