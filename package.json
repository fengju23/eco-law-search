{
  "name": "eco-code-search",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "node scripts/prepare-mobile.cjs && vite build --mode mobile",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "node scripts/test-search.mjs",
    "cap:sync": "npm run build:mobile && cap sync android",
    "apk": "npm run cap:sync && cd android && gradlew assembleDebug",
    "apk:release": "npm run cap:sync && cd android && gradlew assembleRelease",
    "gen:sound": "node scripts/gen-sound.cjs 4",
    "gen:sound:mobile": "node scripts/gen-sound.cjs --out=public-mobile/sounds --sr=22050 --dur=30 --mono --variants=1 --only=rain,stream,pinewind,bell --jobs=4",
    "gen:art": "node scripts/gen-art-png.cjs",
    "gen:paper": "node scripts/gen-paper.cjs",
    "gen:solar": "node scripts/gen-solar.cjs",
    "gen:law": "node scripts/extract-law.cjs",
    "gen:icon": "node scripts/gen-app-icon.cjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
